GITHUB_APP_ID=123456
GITHUB_REPOSITORY=your-owner/your-demo-repo
# Copy the downloaded PEM here, using literal \n between lines, or export the
# contents of the PEM file from your shell. Both PKCS#1 and PKCS#8 are accepted.
GITHUB_PRIVATE_KEY='-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----'
BROKER_TOKEN=replace-with-a-random-secret-at-least-32-characters
HOST=127.0.0.1
PORT=3000
PUBLIC_HOST=localhost
