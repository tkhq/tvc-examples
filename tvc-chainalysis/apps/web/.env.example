# ── zeroShadow Hermod (threat intel) ─────────────────────────────────────────
# These values are consumed by the TVC Go app; they belong in the deployment
# manifest as pivot args or in the Hermod agent's own config, NOT in the
# Next.js runtime. They are documented here for completeness only.
#
# HERMOD_URL             — base URL of the Hermod agent (e.g. http://hermod:8080)
# HERMOD_HMAC_KEY        — per-account HMAC secret used to sign addresses. NEVER
#                          expose this to the browser or store it in this .env file
#                          if the file is committed. Rotate on suspected compromise.
# HERMOD_API_KEY         — optional bearer token if Hermod is configured with one.
#
# See the README addendum for the two connectivity options (co-located sidecar
# vs external URL requiring TVC externalConnectivity: true).

# ── Turnkey (parent org) ──────────────────────────────────────────────────────
# From https://app.turnkey.com/dashboard/api-keys
TURNKEY_API_PUBLIC_KEY=
TURNKEY_API_PRIVATE_KEY=
TURNKEY_ORG_ID=

# Public — safe to expose in the browser
NEXT_PUBLIC_TURNKEY_ORG_ID=

# From https://app.turnkey.com/dashboard/auth → Auth Proxy tab
# Enable Auth Proxy, configure Allowed Origins, then paste the Config ID here
NEXT_PUBLIC_AUTH_PROXY_CONFIG_ID=

# ── TVC App ───────────────────────────────────────────────────────────────────
# Set after deploying the TVC app (see README)
TVC_APP_URL=https://app-<your-app-uuid>.turnkey.cloud
TVC_APP_ID=
