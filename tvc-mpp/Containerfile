# The static pivot binary follows the public TVC template's pinned bases.
FROM stagex/pallet-rust:1.94.0@sha256:4e2d4273a1d5c6d62660968302791f3cf550c3d12629e66314956ff46c97fc0e AS build
ENV RUSTFLAGS="-C target-feature=+crt-static"
WORKDIR /src
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY src ./src
RUN cargo fetch --locked --target x86_64-unknown-linux-musl
RUN --network=none cargo build --locked --release --target x86_64-unknown-linux-musl --bin tvc-mpp

FROM stagex/core-busybox:1.36.1@sha256:cac5d773db1c69b832d022c469ccf5f52daf223b91166e6866d42d6983a3b374
COPY --from=build /src/target/x86_64-unknown-linux-musl/release/tvc-mpp /tvc_app
RUN sha256sum /tvc_app
ENTRYPOINT ["/tvc_app"]
